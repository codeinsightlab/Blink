{
  "version": "1.2",
  "id": "keyflow-system-commands",
  "name": "KeyFlow 系统命令",
  "bindings": [
    { "id": "builtin-copy", "slot": "KEY_1", "name": "复制", "description": "复制当前选中内容", "actions": [{ "executions": { "windows": { "type": "SEND_HOTKEY", "keys": ["CTRL", "C"] }, "macos": { "type": "SEND_HOTKEY", "keys": ["META", "C"] } } }] },
    { "id": "builtin-paste", "slot": "KEY_2", "name": "粘贴", "description": "粘贴剪贴板内容", "actions": [{ "executions": { "windows": { "type": "SEND_HOTKEY", "keys": ["CTRL", "V"] }, "macos": { "type": "SEND_HOTKEY", "keys": ["META", "V"] } } }] },
    { "id": "builtin-cut", "slot": "KEY_3", "name": "剪切", "description": "剪切当前选中内容", "actions": [{ "executions": { "windows": { "type": "SEND_HOTKEY", "keys": ["CTRL", "X"] }, "macos": { "type": "SEND_HOTKEY", "keys": ["META", "X"] } } }] },
    { "id": "builtin-undo", "slot": "KEY_4", "name": "撤销", "description": "撤销上一次操作", "actions": [{ "executions": { "windows": { "type": "SEND_HOTKEY", "keys": ["CTRL", "Z"] }, "macos": { "type": "SEND_HOTKEY", "keys": ["META", "Z"] } } }] },
    { "id": "builtin-redo", "slot": "KEY_5", "name": "重做", "description": "恢复已撤销的操作", "actions": [{ "executions": { "windows": { "type": "SEND_HOTKEY", "keys": ["CTRL", "Y"] }, "macos": { "type": "SEND_HOTKEY", "keys": ["META", "SHIFT", "Z"] } } }] },
    { "id": "builtin-select-all", "slot": "KEY_6", "name": "全选", "description": "选中当前内容", "actions": [{ "executions": { "windows": { "type": "SEND_HOTKEY", "keys": ["CTRL", "A"] }, "macos": { "type": "SEND_HOTKEY", "keys": ["META", "A"] } } }] },
    { "id": "builtin-save", "slot": "KEY_7", "name": "保存", "description": "保存当前文件或内容", "actions": [{ "executions": { "windows": { "type": "SEND_HOTKEY", "keys": ["CTRL", "S"] }, "macos": { "type": "SEND_HOTKEY", "keys": ["META", "S"] } } }] },
    { "id": "builtin-find", "slot": "KEY_8", "name": "查找", "description": "在当前应用中查找", "actions": [{ "executions": { "windows": { "type": "SEND_HOTKEY", "keys": ["CTRL", "F"] }, "macos": { "type": "SEND_HOTKEY", "keys": ["META", "F"] } } }] }
  ],
  "createdAt": "2026-09-01T00:00:00.000Z",
  "updatedAt": "2026-09-01T00:00:00.000Z"
}
